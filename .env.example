# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps > Web app config

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace all "your_*" values with your actual Firebase configuration
# 3. Never commit .env.local to version control
#
# SECURITY NOTE:
# These are client-side Firebase keys that will be exposed in the browser.
# Always configure proper Firestore Security Rules and Authentication to protect your data.
# See the installation guides for recommended security rules.
